-- Получаем родителя для ScreenGui (защищённый, если возможно)
local function getGuiParent()
    -- gethui() — лучший вариант (Delta, Synapse, Krnl и др.)
    if type(gethui) == "function" then
        local ok, hui = pcall(gethui)
        if ok and hui then
            print("[SpinArm] Родитель GUI: gethui()")
            return hui
        end
    end
    -- CoreGui (защищённый)
    local CoreGui = game:GetService("CoreGui")
    print("[SpinArm] Родитель GUI: CoreGui")
    return CoreGui
end

