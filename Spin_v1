        if o:IsA("TextButton") and o.Name:sub(1, 5) == "Angle" then
            o.BackgroundColor3 = Color3.fromRGB(55, 55, 70)
        end
    end
    if activeBtn then activeBtn.BackgroundColor3 = Color3.fromRGB(255, 140, 0) end
end

