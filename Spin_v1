    pcall(findNode)
end)

-- ===== Вращение =====
local function getRotCF(deg)
    local r = math.rad(deg)
    if AXIS == "X" then return CFrame.Angles(r, 0, 0)
    elseif AXIS == "Y" then return CFrame.Angles(0, r, 0)
    else return CFrame.Angles(0, 0, r) end
end

local function apply(deg)
    if not node or not node.Parent then return end
    local rot = getRotCF(deg)
    if nodeType == "AC" then
        pcall(function() node.Transform = rot end)
    elseif nodeType == "Motor6D" then
        if origC0 then
            pcall(function()
                node.C0 = rot * origC0
                node.Transform = CFrame.new()
            end)
        end
    end
end

local function reset()
    if not node then return end
    if nodeType == "AC" then
        pcall(function() node.Transform = CFrame.new() end)
    elseif nodeType == "Motor6D" then
        pcall(function()
            if origC0 then node.C0 = origC0 end
            if origTransform then node.Transform = origTransform end
        end)
    end
end

-- ⚠️ ГЛАВНОЕ ИСПРАВЛЕНИЕ: PreSimulation вместо BindToRenderStep
RunService.PreSimulation:Connect(function(dt)
    if not node or not node.Parent then return end
    if not enabled then return end

    local deg
    if SPIN_MODE then
        angle = (angle + dt * SPEED * 360) % 360
        deg = angle
    else
        deg = HOLD_ANGLE
    end
    apply(deg)
end)

