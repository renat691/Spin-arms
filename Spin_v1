local enabled = true
local SPEED   = 5
local AXIS    = "X"        -- "X", "Y", "Z"
local TOGGLE  = Enum.KeyCode.R
-- ============================================

local angle = 0
local motor, origC0, char

-- ================= ПОИСК МОТОРА =================
local function findMotor(c)
    if not c then return nil end
    -- 1) по имени
    for _, o in ipairs(c:GetDescendants()) do
        if o:IsA("Motor6D") then
            local n = o.Name:gsub("%s", ""):lower()
            if n == "rightshoulder" then return o end
        end
    end
    -- 2) по Part1 (правая рука)
    for _, o in ipairs(c:GetDescendants()) do
        if o:IsA("Motor6D") and o.Part1 then
            local n = o.Part1.Name:gsub("%s", ""):lower()
            if n == "rightarm" or n == "rightupperarm" then
                return o
            end
        end
    end
    return nil
end

local function bindChar(c)
    char = c
    local h = c:WaitForChild("Humanoid", 10)
    if not h then
        warn("[SpinArm] Humanoid не найден")
        return
    end
    task.wait(0.6)
    motor = findMotor(c)
    if motor then
        origC0 = motor.C0
        print("[SpinArm] ✅ Мотор найден:", motor:GetFullName())
    else
        warn("[SpinArm] ❌ Мотор правого плеча не найден")
    end
end

if LP.Character then
    task.spawn(bindChar, LP.Character)
end
LP.CharacterAdded:Connect(function(c)
    task.wait(0.5)
    bindChar(c)
end)

-- ================= ЦИКЛ ВРАЩЕНИЯ =================
RunService.RenderStepped:Connect(function(dt)
    if not enabled then return end
    if not motor or not motor.Parent or not origC0 then return end

    angle += dt * SPEED * math.pi * 2

    local r
    if AXIS == "X" then r = CFrame.Angles(angle, 0, 0)
    elseif AXIS == "Y" then r = CFrame.Angles(0, angle, 0)
    else r = CFrame.Angles(0, 0, angle) end

    pcall(function()
        motor.C0 = r * origC0
    end)
end)

