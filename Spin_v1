local angle = 0
local motor, origC0

-- ================= ПОИСК МОТОРА (широкий) =================
local function findMotor()
    local c = LP.Character
    if not c then return nil end

    local best
    -- 1) точное имя (R6: "Right Shoulder", R15: "RightShoulder")
    for _, o in ipairs(c:GetDescendants()) do
        if o:IsA("Motor6D") then
            local n = o.Name:gsub("[%s_%-]", ""):lower()
            if n == "rightshoulder" then return o end
            if not best and n:find("rightshoulder") then best = o end
        end
    end

    -- 2) по Part1 — правая рука
    for _, o in ipairs(c:GetDescendants()) do
        if o:IsA("Motor6D") and o.Part1 then
            local n = o.Part1.Name:gsub("[%s_%-]", ""):lower()
            if n == "rightarm" or n == "rightupperarm" then return o end
            if not best and n:find("right") and n:find("arm") then best = o end
        end
    end

    -- 3) по Part0 (торс) + Part1 (рука)
    for _, o in ipairs(c:GetDescendants()) do
        if o:IsA("Motor6D") and o.Part0 and o.Part1 then
            local p0 = o.Part0.Name:lower()
            local p1 = o.Part1.Name:lower()
            if (p0:find("torso") or p0:find("chest") or p0:find("upper"))
               and p1:find("right") and p1:find("arm") then
                if not best then best = o end
            end
        end
    end

    return best
end

-- ================= АВТО-ПРИВЯЗКА (в цикле) =================
local lastMotor
task.spawn(function()
    while true do
        if LP.Character then
            local m = findMotor()
            if m and m ~= motor then
                motor = m
                origC0 = m.C0
                print("[SpinArm] ✅ Мотор найден:", m:GetFullName())
                lastMotor = m
            elseif not m and motor and not motor.Parent then
                motor = nil
                origC0 = nil
                print("[SpinArm] Мотор пропал, ищу снова...")
            end
        end
        task.wait(1)
    end
end)

-- ================= ВРАЩЕНИЕ =================
RunService.RenderStepped:Connect(function(dt)
    if not enabled then return end
    if not motor or not origC0 then return end
    if not motor.Parent then return end

    angle += dt * SPEED * math.pi * 2
    local r
    if AXIS == "X" then r = CFrame.Angles(angle, 0, 0)
    elseif AXIS == "Y" then r = CFrame.Angles(0, angle, 0)
    else r = CFrame.Angles(0, 0, angle) end

    pcall(function()
        motor.C0 = r * origC0
    end)
end)

