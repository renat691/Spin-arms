local function upd()
    if enabled then
        toggleBtn.BackgroundColor3 = Color3.fromRGB(0, 170, 0)
        toggleBtn.Text = "ВКЛ (R)"
    else
        toggleBtn.BackgroundColor3 = Color3.fromRGB(120, 40, 40)
        toggleBtn.Text = "ВЫКЛ (R)"
    end
end

toggleBtn.MouseButton1Click:Connect(function()
    enabled = not enabled
    upd()
end)

