-- ================= ПОЛНЫЙ ДАМП ПЕРСОНАЖА =================
local function fullDump(c)
    print("[Dump] === Полный дамп персонажа: " .. c.Name .. " ===")
    local counts = {}
    for _, o in ipairs(c:GetDescendants()) do
        counts[o.ClassName] = (counts[o.ClassName] or 0) + 1
    end
    print("[Dump] Классы объектов:")
    for cls, n in pairs(counts) do
        print(string.format("   %-25s x%d", cls, n))
    end

    print("[Dump] --- Motor6D ---")
    local anyMotor = false
    for _, o in ipairs(c:GetDescendants()) do
        if o:IsA("Motor6D") then
            anyMotor = true
            print(string.format("   M6D: %-20s P0=%-18s P1=%s",
                o.Name,
                o.Part0 and o.Part0.Name or "nil",
                o.Part1 and o.Part1.Name or "nil"))
        end
    end
    if not anyMotor then print("   (нет)") end

    print("[Dump] --- Bones (первые 30) ---")
    local bn = 0
    for _, o in ipairs(c:GetDescendants()) do
        if o:IsA("Bone") then
            bn += 1
            if bn <= 30 then
                print(string.format("   Bone: %-25s Parent=%s",
                    o.Name, o.Parent and o.Parent.Name or "nil"))
            end
        end
    end
    if bn == 0 then print("   (нет)") else print("   ... всего:", bn) end

    print("[Dump] --- Weld / WeldConstraint ---")
    for _, o in ipairs(c:GetDescendants()) do
        if o:IsA("Weld") or o:IsA("WeldConstraint") then
            print(string.format("   %s: %-18s P0=%-18s P1=%s", o.ClassName,
                o.Name,
                o.Part0 and o.Part0.Name or "-",
                o.Part1 and o.Part1.Name or "-"))
        end
    end

    print("[Dump] --- Части (Part/MeshPart) с 'arm' в имени ---")
    for _, o in ipairs(c:GetDescendants()) do
        if (o:IsA("BasePart")) then
            local n = o.Name:lower()
            if n:find("arm") or n:find("hand") or n:find("shoulder") then
                print(string.format("   %s: %s", o.ClassName, o.Name))
            end
        end
    end

    print("[Dump] === Конец дампа ===")
end

-- ================= ПОИСК ЦЕЛИ =================
local function findTarget()
    local c = LP.Character
    if not c then return nil, nil end

    -- 1) Motor6D Right Shoulder (R6 + R15)
    for _, o in ipairs(c:GetDescendants()) do
        if o:IsA("Motor6D") then
            local n = o.Name:gsub("[%s_%-]", ""):lower()
            if n == "rightshoulder" then return o, "Motor6D" end
        end
    end
    for _, o in ipairs(c:GetDescendants()) do
        if o:IsA("Motor6D") and o.Part1 then
            local n = o.Part1.Name:gsub("[%s_%-]", ""):lower()
            if n == "rightarm" or n == "rightupperarm" then return o, "Motor6D" end
        end
    end

    -- 2) Bone с именем про правую руку
    for _, o in ipairs(c:GetDescendants()) do
        if o:IsA("Bone") then
            local n = o.Name:lower()
            if n:find("right") and (n:find("shoulder") or n:find("upperarm") or n:find("arm")) then
                return o, "Bone"
            end
        end
    end

    -- 3) Weld/WeldConstraint на правую руку
    for _, o in ipairs(c:GetDescendants()) do
        if o:IsA("Weld") then
            local p1 = o.Part1 and o.Part1.Name:lower() or ""
            if p1:find("right") and p1:find("arm") then return o, "Weld" end
        end
    end

    -- 4) Motor (legacy)
    for _, o in ipairs(c:GetDescendants()) do
        if o:IsA("Motor") then
            if o.Name:lower():find("right") and o.Name:lower():find("shoulder") then
                return o, "Motor"
            end
        end
    end

    return nil, nil
end

-- ================= ПРИВЯЗКА =================
local function bind()
    local c = LP.Character
    if not c then return end

    target, targetType = findTarget()
    if not target then
        warn("[SpinArm] ❌ Не нашёл ни мотор, ни bone, ни weld правой руки")
        fullDump(c)
        return
    end

    if targetType == "Motor6D" or targetType == "Motor" then
        origC0 = target.C0
        origTransform = target.Transform
        print("[SpinArm] ✅ Привязался к " .. targetType .. ": " .. target:GetFullName())
    elseif targetType == "Bone" then
        origTransform = target.Transform
        print("[SpinArm] ✅ Привязался к Bone: " .. target:GetFullName())
    elseif targetType == "Weld" then
        origC0 = target.C0
        print("[SpinArm] ✅ Привязался к Weld: " .. target:GetFullName())
    end
end

-- Авто-привязка в цикле
task.spawn(function()
    while true do
        if LP.Character and (not target or not target.Parent) then
            pcall(bind)
        end
        task.wait(1)
    end
end)

LP.CharacterAdded:Connect(function()
    target, targetType, origC0, origTransform = nil, nil, nil, nil
    task.wait(1)
    pcall(bind)
end)

-- ================= ВРАЩЕНИЕ =================
RunService.RenderStepped:Connect(function(dt)
    if not target or not target.Parent then return end

    -- Выключено — вернуть исходное
    if not enabled then
        pcall(function()
            if targetType == "Motor6D" and origC0 then
                target.C0 = origC0
                if origTransform then target.Transform = origTransform end
            elseif targetType == "Bone" and origTransform then
                target.Transform = origTransform
            elseif targetType == "Weld" and origC0 then
                target.C0 = origC0
            elseif targetType == "Motor" and origC0 then
                target.C0 = origC0
            end
        end)
        return
    end

    angle += dt * SPEED * math.pi * 2
    local r
    if AXIS == "X" then r = CFrame.Angles(angle, 0, 0)
    elseif AXIS == "Y" then r = CFrame.Angles(0, angle, 0)
    else r = CFrame.Angles(0, 0, angle) end

    pcall(function()
        if targetType == "Motor6D" then
            target.C0 = r * origC0
            target.Transform = CFrame.new()  -- глушим анимацию R15
        elseif targetType == "Bone" then
            target.Transform = r * (origTransform or CFrame.new())
        elseif targetType == "Weld" then
            target.C0 = r * origC0
        elseif targetType == "Motor" then
            target.C0 = r * origC0
        end
    end)
end)

