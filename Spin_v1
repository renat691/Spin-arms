-- ===== Поиск =====
local function findNode()
    local c = LP.Character
    if not c then return end
    local hum = c:FindFirstChildOfClass("Humanoid")
    if hum then
        rigType = (hum.RigType == Enum.HumanoidRigType.R15) and "R15" or "R6"
    end

    local rua = c:FindFirstChild("RightUpperArm")
    if rua then
        local t = rua:FindFirstChild("RightShoulder")
        if t and t:IsA("AnimationConstraint") then
            node, nodeType = t, "AC"
            print("[SpinArm] ✅ AC (R15 новый)")
            return
        end
        if t and t:IsA("Motor6D") then
            node, nodeType = t, "Motor6D"
            origC0, origTransform = t.C0, t.Transform
            print("[SpinArm] ✅ Motor6D (R15)")
            return
        end
    end

    local torso = c:FindFirstChild("Torso")
    if torso then
        local m = torso:FindFirstChild("Right Shoulder")
        if m and m:IsA("Motor6D") then
            node, nodeType = m, "Motor6D"
            origC0, origTransform = m.C0, m.Transform
            print("[SpinArm] ✅ Motor6D (R6)")
            return
        end
    end

    for _, o in ipairs(c:GetDescendants()) do
        if o:IsA("AnimationConstraint") and o.Name:gsub("[%s_%-]",""):lower() == "rightshoulder" then
            node, nodeType = o, "AC"
            print("[SpinArm] ✅ AC (fallback)")
            return
        end
    end
    for _, o in ipairs(c:GetDescendants()) do
        if o:IsA("Motor6D") and o.Name:gsub("[%s_%-]",""):lower() == "rightshoulder" then
            node, nodeType = o, "Motor6D"
            origC0, origTransform = o.C0, o.Transform
            print("[SpinArm] ✅ Motor6D (fallback)")
            return
        end
    end
    warn("[SpinArm] ❌ Не найден узел")
end

task.spawn(function()
    while true do
        if LP.Character and (not node or not node.Parent) then
            node, nodeType, origC0, origTransform = nil, nil, nil, nil
            pcall(findNode)
        end
        task.wait(1)
    end
end)

LP.CharacterAdded:Connect(function()
